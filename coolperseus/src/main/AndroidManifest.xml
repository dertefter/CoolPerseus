<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name="com.dertefter.coolperseus.CoolPerseus"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TransparentOverlay">
        <activity
            android:name="com.dertefter.coolperseus.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CoolPerseus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.dertefter.coolperseus.AnimationOverlayActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
        </activity>

        <service
            android:name="com.dertefter.coolperseus.AnimationService"
            android:exported="false" />

    </application>

</manifest>